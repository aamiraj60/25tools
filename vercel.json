{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "25tools-tau.vercel.app"
        }
      ],
      "destination": "https://toolguest.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "25tools-mk-aamir.vercel.app"
        }
      ],
      "destination": "https://toolguest.com/$1",
      "permanent": true
    }
  ],
  "regions": [
    "lhr1"
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}