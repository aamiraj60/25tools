{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/tools/timestamp-link-generator", "destination": "/youtube-timestamp.html" },
    { "source": "/tools/:slug", "destination": "/:slug.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
